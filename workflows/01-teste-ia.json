    {
      "parameters": {
        "jsCode": "// Escapa caracteres que quebram o modo HTML do Telegram\nconst esc = (t) => String(t ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst todos = $('Code').all().map(i => i.json);       // todos os anúncios\nconst filtrados = $('Filter').all().map(i => i.json); // os que foram para a IA\nconst ia = $input.all().map(i => i.json.output);      // respostas da IA (mesma ordem)\n\nconst atencao = filtrados.map((a, i) =>\n  `• <b>${esc(a.anuncio)}</b> (${a.campanha})\\n` +\n  `  ROAS ${a.roas_real}x | mín ${a.roas_minimo}x | ${a.cliques} cliques\\n` +\n  `  👉 <b>${ia[i].acao}</b>: ${esc(ia[i].justificativa)}`\n);\n\nconst saudaveis = todos\n  .filter(a => a.status === 'saudavel')\n  .map(a => `• ${esc(a.anuncio)}: ROAS ${a.roas_real}x`);\n\nconst insuficientes = todos\n  .filter(a => a.status === 'dados_insuficientes')\n  .map(a => `• ${esc(a.anuncio)}: ${a.cliques} cliques`);\n\nlet msg = `📊 <b>Relatório Mercado Ads, ${$now.toFormat('dd/MM/yyyy')}</b>\\n\\n`;\nmsg += `⚠️ <b>Ações sugeridas (${atencao.length})</b>\\n${atencao.join('\\n\\n') || 'Nenhuma'}\\n\\n`;\nmsg += `✅ <b>Saudáveis (${saudaveis.length})</b>\\n${saudaveis.join('\\n') || 'Nenhum'}\\n\\n`;\nmsg += `⏳ <b>Dados insuficientes (${insuficientes.length})</b>\\n${insuficientes.join('\\n') || 'Nenhum'}`;\n\nreturn [{ json: { mensagem: msg } }];"
      },
