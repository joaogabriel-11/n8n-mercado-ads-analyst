      "parameters": {
        "jsCode": "const anuncios = [\n  { anuncio: 'Caixa de direção Gol G5', campanha: 'Escala', preco: 800, cliques: 85, investimento: 120, vendas_ads: 1600, roas_minimo: 5 },\n  { anuncio: 'Caixa de direção Palio',  campanha: 'Escala', preco: 650, cliques: 60, investimento: 150, vendas_ads: 650,  roas_minimo: 5.5 },\n  { anuncio: 'Caixa de direção Celta',  campanha: 'Teste',  preco: 700, cliques: 12, investimento: 20,  vendas_ads: 0,    roas_minimo: 5 },\n];\n\nconst PISO_CLIQUES = 30;\n\nreturn anuncios.map(a => {\n  const roas_real = a.investimento > 0\n    ? Number((a.vendas_ads / a.investimento).toFixed(2))\n    : 0;\n\n  let status;\n  if (a.cliques < PISO_CLIQUES) status = 'dados_insuficientes';\n  else if (roas_real >= a.roas_minimo) status = 'saudavel';\n  else status = 'abaixo_do_minimo';\n\n  return { json: { ...a, roas_real, status } };\n});"
      },
