      "name": "Filter"
    },
    {
      "parameters": {
        "jsCode": "const PISO_CLIQUES = 30;\n\n// Planilha em pt-BR pode mandar \"5,5\" como texto: converte para número\nconst num = (v) => {\n  if (typeof v === 'number') return v;\n  const s = String(v ?? '').trim();\n  return s.includes(',') ? Number(s.replace(/\\./g, '').replace(',', '.')) : Number(s);\n};\n\nreturn $input.all().map(item => {\n  const r = item.json;\n  const a = {\n    anuncio: r.anuncio,\n    campanha: r.campanha,\n    preco: num(r.preco),\n    cliques: num(r.cliques),\n    investimento: num(r.investimento),\n    vendas_ads: num(r.vendas_ads),\n    roas_minimo: num(r.roas_minimo),\n  };\n\n  const roas_real = a.investimento > 0\n    ? Number((a.vendas_ads / a.investimento).toFixed(2))\n    : 0;\n\n  let status;\n  if (a.cliques < PISO_CLIQUES) status = 'dados_insuficientes';\n  else if (roas_real < a.roas_minimo) status = 'abaixo_do_minimo';\n  else if (a.campanha === 'Teste' && roas_real >= a.roas_minimo * 1.5) status = 'candidato_escala';\n  else status = 'saudavel';\n\n  return { json: { ...a, roas_real, status } };\n});"
      },
