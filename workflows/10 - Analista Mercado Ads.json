    {
      "parameters": {
        "jsCode": "const esc = (t) => String(t ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst todos = $input.all().map(i => i.json);\n\n// Resultados da IA (podem não existir se nada passou pelo filtro)\nlet filtrados = [], ia = [];\ntry {\n  filtrados = $('Filter').all().map(i => i.json);\n  ia = $('Basic LLM Chain').all().map(i => i.json.output);\n} catch (e) { /* IA não rodou nesta semana */ }\n\nconst atencao = filtrados.map((a, i) => ia[i]\n  ? `• <b>${esc(a.anuncio)}</b> (${a.campanha})\\n` +\n    `  ROAS ${a.roas_real}x | alvo ${a.roas_minimo}x | ${a.cliques} cliques | R$ ${a.investimento.toFixed(2)}\\n` +\n    `  👉 <b>${ia[i].acao}</b>: ${esc(ia[i].justificativa)}`\n  : `• <b>${esc(a.anuncio)}</b>: ${a.status} (sem análise da IA)`\n);\n\nconst listar = (status, fmt) => todos.filter(a => a.status === status).map(fmt);\nconst saudaveis = listar('saudavel', a => `• ${esc(a.anuncio)}: ROAS ${a.roas_real}x`);\nconst semEntrega = listar('sem_entrega', a => `• ${esc(a.anuncio)} (${a.campanha})`);\nconst insuf = listar('dados_insuficientes',\n  a => `• ${esc(a.anuncio)}: ${a.cliques} cliques, R$ ${a.investimento.toFixed(2)}`);\n\nconst gasto = todos.reduce((s, a) => s + a.investimento, 0);\nconst vendas = todos.reduce((s, a) => s + a.vendas_ads, 0);\nconst roasGeral = gasto > 0 ? (vendas / gasto).toFixed(2) : '0';\n\nlet msg = `📊 <b>Relatório Mercado Ads, ${$now.toFormat('dd/MM/yyyy')}</b>\\n`;\nmsg += `Gasto: R$ ${gasto.toFixed(2)} | Vendas Ads: R$ ${vendas.toFixed(2)} | ROAS geral: ${roasGeral}x\\n\\n`;\nmsg += `⚠️ <b>Ações sugeridas (${atencao.length})</b>\\n${atencao.join('\\n\\n') || 'Nenhuma'}\\n\\n`;\nmsg += `🚫 <b>Sem impressões (${semEntrega.length})</b>\\n${semEntrega.join('\\n') || 'Nenhum'}\\n\\n`;\nmsg += `✅ <b>Saudáveis (${saudaveis.length})</b>\\n${saudaveis.join('\\n') || 'Nenhum'}\\n\\n`;\nmsg += `⏳ <b>Dados insuficientes (${insuf.length})</b>\\n${insuf.join('\\n') || 'Nenhum'}`;\n\nreturn [{ json: { mensagem: msg } }];"
      },
