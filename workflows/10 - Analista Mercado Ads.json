    {
      "parameters": {
        "jsCode": "const PISO_CLIQUES = 30;   // avalia com 30+ cliques...\nconst PISO_GASTO = 50;     // ...ou com R$ 50+ gastos\nconst ROAS_PADRAO = 6;     // usado se a campanha não informar roas_target\n\n// Mapa campanha -> nome e ROAS alvo\nconst campanhas = {};\nfor (const c of $('Separar campanhas').all()) {\n  campanhas[c.json.id] = {\n    nome: c.json.name,\n    roas_alvo: Number(c.json.roas_target) || ROAS_PADRAO,\n  };\n}\n\nreturn $input.all().map(item => {\n  const a = item.json;\n  const m = a.metrics || {};\n  const camp = campanhas[a.campaign_id] || { nome: String(a.campaign_id), roas_alvo: ROAS_PADRAO };\n  const tipo = camp.nome.toLowerCase().includes('escala') ? 'Escala' : 'Teste';\n\n  const custo = Number(m.cost) || 0;\n  const vendas = Number(m.total_amount) || 0;\n  const cliques = Number(m.clicks) || 0;\n  const impressoes = Number(m.prints) || 0;\n  const roas_real = custo > 0 ? Number((vendas / custo).toFixed(2)) : 0;\n\n  let status;\n  if (impressoes === 0) status = 'sem_entrega';\n  else if (cliques < PISO_CLIQUES && custo < PISO_GASTO) status = 'dados_insuficientes';\n  else if (roas_real < camp.roas_alvo) status = 'abaixo_do_minimo';\n  else if (tipo === 'Teste' && roas_real >= camp.roas_alvo * 1.5) status = 'candidato_escala';\n  else status = 'saudavel';\n\n  return { json: {\n    item_id: a.item_id,\n    anuncio: a.title,\n    preco: a.price,\n    campanha: tipo,\n    campanha_nome: camp.nome,\n    cliques, impressoes,\n    investimento: custo,\n    vendas_ads: vendas,\n    unidades: Number(m.units_quantity) || 0,\n    cpc: Number(m.cpc) || 0,\n    roas_real,\n    roas_minimo: camp.roas_alvo,\n    status,\n  }};\n});"
      },
