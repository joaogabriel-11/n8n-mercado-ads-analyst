    {
      "parameters": {
        "jsCode": "const esc = (t) => String(t ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst exec = $json.execution || {};\nconst wf = $json.workflow || {};\nconst erro = String(exec.error?.message || 'Erro desconhecido').slice(0, 500);\n\n// Dica de diagnóstico conforme o tipo de erro\nlet dica = 'Abra a execução no n8n para ver os detalhes.';\nif (/invalid_grant|401|unauthorized/i.test(erro)) {\n  dica = 'Provável problema de token. Rode o 02; se falhar, refaça a autorização com o 90.';\n} else if (/429|quota|rate/i.test(erro)) {\n  dica = 'Limite de requisições atingido. Tente rodar de novo mais tarde.';\n} else if (/ENOTFOUND|ECONNRESET|ETIMEDOUT|timeout|5\\d\\d/i.test(erro)) {\n  dica = 'Falha de conexão ou instabilidade da API. Tente rodar de novo.';\n}\n\nconst msg =\n  `🚨 <b>Falha no workflow</b>\\n\\n` +\n  `<b>Workflow:</b> ${esc(wf.name)}\\n` +\n  `<b>Nó:</b> ${esc(exec.lastNodeExecuted)}\\n` +\n  `<b>Erro:</b> ${esc(erro)}\\n` +\n  `<b>Quando:</b> ${$now.toFormat('dd/MM/yyyy HH:mm')}\\n` +\n  `<b>Execução:</b> ${exec.id ?? '-'}\\n\\n` +\n  `💡 ${dica}`;\n\nreturn [{ json: { mensagem: msg } }];"
      },
